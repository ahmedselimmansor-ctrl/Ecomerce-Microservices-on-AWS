{
  "uid": "souq-checkout",
  "title": "SOUQ \u2014 Checkout",
  "tags": [
    "souq",
    "checkout",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "description": "The one board that answers 'is checkout working?'. Row 1 is the customer experience, row 2 is the invariants that must always read zero, row 3 is the event machinery, row 4 is degradation the customer feels but that is not an outage.",
  "panels": [
    {
      "id": 1,
      "title": "Orders placed",
      "type": "stat",
      "description": "Rate of accepted orders. A drop to zero with traffic still arriving is the first sign of a checkout outage.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(souq_saga_transitions_total{trigger=\"place\"}[5m]))",
          "legendFormat": "orders/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Confirmed vs cancelled",
      "type": "timeseries",
      "description": "Locally the mock PSP declines ~10% on purpose, so a cancellation floor is expected. In production a rising ratio is a payment or stock problem.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(souq_saga_duration_seconds_count{outcome=\"confirmed\"}[5m]))",
          "legendFormat": "confirmed",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(souq_saga_duration_seconds_count{outcome=\"cancelled\"}[5m]))",
          "legendFormat": "cancelled",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Checkout p99",
      "type": "timeseries",
      "description": "SLO is 800ms at p99.",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{route=\"/v1/orders\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{route=\"/v1/orders\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 2.0
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Saga settle time",
      "type": "timeseries",
      "description": "Order accepted to terminal state. This is what the customer actually waits for. Target p99 < 2s.",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(souq_saga_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(souq_saga_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "STUCK SAGAS",
      "type": "stat",
      "description": "PAGE if non-zero for 5 minutes. These are past the point of no return and cannot roll back \u2014 docs/runbooks/stuck-saga.md.",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "souq_saga_stuck_orders",
          "legendFormat": "stuck",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Illegal saga transitions",
      "type": "stat",
      "description": "MUST BE ZERO. Non-zero means the implementation has diverged from the verified design \u2014 docs/DESIGN-INVARIANTS.md \u00a71.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(souq_saga_illegal_transitions_total[1h]))",
          "legendFormat": "1h",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Reservation tombstones",
      "type": "timeseries",
      "description": "Expected to be rare but never zero. A spike means order-service is timing out early \u2014 usually the broker or the PSP struggling. docs/DESIGN-INVARIANTS.md \u00a72.",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(souq_reservation_tombstones_total[5m]))",
          "legendFormat": "releases that overtook their reserve",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "TTL sweeper activity",
      "type": "timeseries",
      "description": "Should be near zero. The saga releases explicitly; the sweeper firing means one did not.",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(souq_reservation_ttl_expiries_total[5m]))",
          "legendFormat": "reservations the saga failed to release",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 20,
      "title": "Outbox backlog",
      "type": "timeseries",
      "description": "The DERIVATIVE matters more than the depth. A backlog of 5000 that is draining is fine; 500 and growing is not.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "souq_outbox_unpublished",
          "legendFormat": "{{service}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "title": "Events consumed",
      "type": "timeseries",
      "description": "applied / duplicate / filtered / dlq. A rising `dlq` line is the one to watch.",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(souq_events_consumed_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "title": "Outbox publish lag p99",
      "type": "timeseries",
      "description": "Time from an event being written to it reaching Kafka.",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(souq_outbox_publish_lag_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "title": "Carts priced at list price",
      "type": "timeseries",
      "description": "pricing-engine unreachable. Checkout still works; customers just do not see their promotions.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(souq_cart_pricing_degraded_total[5m]))",
          "legendFormat": "degraded carts/s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (outcome) (rate(souq_pricing_calls_total[5m]))",
          "legendFormat": "pricing {{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 31,
      "title": "Stockouts by SKU",
      "type": "timeseries",
      "description": "A merchandising signal before it is an engineering one: we are advertising things we do not have.",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (sku) (increase(souq_stockouts_total[1h])))",
          "legendFormat": "{{sku}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 32,
      "title": "Payment outcomes",
      "type": "timeseries",
      "description": "Reserved / insufficient / duplicate.",
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(souq_reservations_total[5m]))",
          "legendFormat": "reservation {{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {}
        },
        "overrides": []
      }
    }
  ]
}